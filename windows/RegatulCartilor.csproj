<Project Sdk="Microsoft.NET.Sdk">
  <!-- Regatul Cărților pentru Windows: o fereastră cu WebView2 care deschide aplicația de pe GitHub Pages,
       aceeași ca pe iPhone, deci se actualizează odată cu ea. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>RegatulCartilor</AssemblyName>
    <RootNamespace>RegatulCartilor</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Product>Regatul Cărților</Product>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="installer.iss" />
  </ItemGroup>
</Project>
